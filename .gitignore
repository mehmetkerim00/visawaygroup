# ============================================================================
#  .gitignore — что НЕ попадает в репозиторий на GitHub.
#
#  Всё, что здесь перечислено, остаётся только на вашем компьютере.
# ============================================================================

# Резервные копии сайта.
# ЭТО ВАЖНО: в backups/ лежат полные копии сайта на разные даты, то есть
# вся история правок. Репозиторий публичный — там этому не место.
# Копии нужны вам локально, на GitHub они бесполезны и весят 10 МБ.
backups/

# Служебные папки
node_modules/
.vercel
__pycache__/
*.pyc

# Мусор операционной системы и редакторов
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Полные исходники шрифтов.
# Сайт использует урезанные шрифты в assets/fonts/. Полные версии нужны
# только чтобы пересобрать урезанные (python3 scripts/subset-fonts.py).
# Если будете пересобирать шрифты на другом компьютере — уберите эту строку.
assets/fonts/full/

# Служебная картинка с проверкой логотипов, на сайте не используется
assets/0_proverka_assetov.png
.env*
