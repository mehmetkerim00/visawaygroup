# Что НЕ выгружается на Vercel.
# Сайт — готовые html-файлы. Всё, что перечислено ниже, нужно только
# на вашем компьютере: серверу оно бесполезно и лишь замедляет выгрузку.

# Резервные копии сайта — 10 МБ истории правок
backups/

# Программы, которые собирают сайт локально
scripts/
partials/

# Данные: сама сборка сайта на сервере не идёт, но серверным функциям
# панели нужны названия стран и подписи — они их читают отсюда.
data/*
!data/countries.json
!data/requirements.json

# Полные исходники шрифтов (сайт использует урезанные)
assets/fonts/full/
assets/0_*.png

# Инструкции для владельцев, а не для посетителей
README.md
DEPLOY.md
CONTENT-MAP.md
HANDOVER.md

# Настройки для других хостингов — на Vercel не используются
.htaccess
nginx.conf.example

# Служебное
node_modules/
__pycache__/
.DS_Store
.git/
