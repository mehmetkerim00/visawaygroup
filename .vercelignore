# Что НЕ выгружается на Vercel.
# Сайт — готовые html-файлы. Всё, что перечислено ниже, нужно только
# на вашем компьютере: серверу оно бесполезно и лишь замедляет выгрузку.

# Резервные копии сайта — 10 МБ истории правок
backups/

# Программы сборки и данные.
#
# Раньше их сюда не возили: сайт лежал готовыми файлами. Теперь его
# собирает сам Vercel — иначе правка из панели не могла бы попасть на
# страницы, ведь требования лежат в базе, а не в репозитории.
# Значит, всё, что нужно сборке, должно быть на хостинге.
scripts/__pycache__/
partials/.keep

# Полные исходники шрифтов (сайт использует урезанные)
assets/fonts/full/
assets/0_*.png

# Инструкции для владельцев, а не для посетителей
README.md
DEPLOY.md
CONTENT-MAP.md
HANDOVER.md

# Настройки для других хостингов Vercel не читает, но выгружать их надо.
#
# Сборка теперь идёт на самом Vercel и кончается проверкой preflight,
# а та требует, чтобы проект был целым — в том числе с .htaccess.
# Держать здесь проверку и там проект в разном составе нельзя: тогда
# сборка падала бы на том, чего локально не видно. Файлы крошечные
# и на Vercel просто лежат без дела.

# Служебное
node_modules/
__pycache__/
.DS_Store
.git/
