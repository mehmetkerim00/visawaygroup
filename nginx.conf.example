# ============================================================================
#  nginx.conf.example — заготовка настроек для хостинга на nginx
#
#  Это не рабочий файл, а образец. Скопируйте нужный кусок в конфигурацию
#  вашего сервера и замените ДВЕ вещи:
#     server_name  — на ваш домен
#     root         — на путь к папке с сайтом
#
#  Если хостинг на Apache, этот файл не нужен — там работает .htaccess.
# ============================================================================

server {
    listen 80;
    listen [::]:80;

    server_name ЗАПОЛНИТЬ.tm www.ЗАПОЛНИТЬ.tm;
    root /var/www/ЗАПОЛНИТЬ;

    index index.html;
    charset utf-8;

    # --- Страница ошибки ---------------------------------------------------
    error_page 404 /404.html;

    # --- Сжатие ------------------------------------------------------------
    # Ужимает html, css и svg примерно вчетверо. Для посетителя на медленном
    # интернете это главное ускорение.
    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/manifest+json
        application/xml
        image/svg+xml;
    # woff2 и png уже сжаты — повторное сжатие только тратит время сервера.

    # --- Кэширование -------------------------------------------------------
    # Стили, скрипты, шрифты и картинки не меняются — храним у посетителя год.
    location ~* \.(css|js|woff2|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Страницы должны обновляться сразу после правки текста.
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache";
    }

    location = /sitemap.xml { expires 1d; }
    location = /robots.txt  { expires 1d; }

    # --- Немного безопасности ----------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --- Типы файлов -------------------------------------------------------
    types {
        font/woff2                woff2;
        application/manifest+json webmanifest;
        image/svg+xml             svg;
    }
}

# ----------------------------------------------------------------------------
#  Когда появится сертификат, добавьте перенаправление на https:
#
#  server {
#      listen 443 ssl http2;
#      server_name ЗАПОЛНИТЬ.tm;
#      ssl_certificate     /путь/fullchain.pem;
#      ssl_certificate_key /путь/privkey.pem;
#      ... тот же root и те же location, что выше ...
#  }
#
#  server {
#      listen 80;
#      server_name ЗАПОЛНИТЬ.tm www.ЗАПОЛНИТЬ.tm;
#      return 301 https://ЗАПОЛНИТЬ.tm$request_uri;
#  }
# ----------------------------------------------------------------------------
